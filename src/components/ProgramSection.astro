---
import { renderInlineMarkdown } from '../lib/markdown'
import type { ProgramParagraph } from '../lib/programSections'

interface Props {
  /**
   * `dark` — the framing/summary highlight bands (bg-metsa).
   * `light` / `tint` — alternating backgrounds for numbered requirement bands.
   */
  tone: 'dark' | 'light' | 'tint'
  /** Eyebrow label above the heading, e.g. "Vaatimus 1 / 5". */
  label?: string
  /** Left out on the continuation of a section that a quote band splits. */
  heading?: string
  paragraphs: ProgramParagraph[]
  /**
   * Index of `paragraphs[0]` within the whole section, so only the section's
   * real first paragraph gets the lead style when a quote band splits it.
   */
  firstParagraphIndex?: number
}

const { tone, label, heading, paragraphs, firstParagraphIndex = 0 } = Astro.props

const TONE_STYLES = {
  dark: {
    section: 'bg-metsa text-kerma',
    prose: 'prose-body-dark',
    eyebrow: 'text-vihrea',
    quoteBorder: 'border-vihrea',
  },
  light: {
    section: 'bg-kerma text-musta',
    prose: 'prose-body',
    eyebrow: 'text-vihreat-brand',
    quoteBorder: 'border-vihreat-brand',
  },
  tint: {
    section: 'bg-surface-green text-metsa',
    prose: 'prose-body',
    eyebrow: 'text-metsa',
    quoteBorder: 'border-metsa',
  },
} as const

const styles = TONE_STYLES[tone]
---

<section class:list={['px-4 py-20 sm:px-6 sm:py-28', styles.section]}>
  <div class="content-max mx-auto">
    {label && <p class:list={['text-eyebrow mb-3', styles.eyebrow]}>{label}</p>}
    {heading && <h2 class="text-display mb-8">{heading}</h2>}
    <div class="space-y-4">
      {
        paragraphs.map((paragraph, i) => {
          if (paragraph.type === 'quote') {
            return (
              <blockquote
                class:list={['border-l-4 pl-6 text-xl font-semibold italic', styles.quoteBorder]}
                set:html={renderInlineMarkdown(paragraph.text)}
              />
            )
          }
          if (paragraph.type === 'attribution') {
            return <p class="text-sm font-semibold opacity-70">{paragraph.text}</p>
          }
          return (
            <p
              class:list={[
                styles.prose,
                tone === 'dark'
                  ? 'text-lg leading-relaxed opacity-90'
                  : firstParagraphIndex + i === 0
                    ? 'text-lg font-medium'
                    : 'text-base',
              ]}
              set:html={renderInlineMarkdown(paragraph.text)}
            />
          )
        })
      }
    </div>
    <slot />
  </div>
</section>
