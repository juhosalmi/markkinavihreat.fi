---
// Gallery teaser for one person. The full bio and profile links live only on
// the person page, so that page — not the gallery — is the one search engines
// and answer engines associate with the person's name.
import type { ImageMetadata } from 'astro'
import { Picture } from 'astro:assets'

interface Props {
  name: string
  /** The person's own page. */
  href: string
  /** The person's 3:4 `card` crop where one exists, else the full photo. */
  photo: ImageMetadata
  candidateBadge?: string
  /** District key, exposed on the badge for the about page's district filter. */
  district?: string
  /** The candidate's donation form, linked beside the cta. */
  donationUrl?: string
  /** Link text for the donation form, e.g. "Lahjoita". */
  donateLabel: string
  /** The bio's opening sentence (see firstSentenceOfBio). */
  summary: string
  /** Link text for the person page, e.g. "Lue lisää". */
  cta: string
}

const { name, href, photo, candidateBadge, district, donationUrl, donateLabel, summary, cta } =
  Astro.props
---

<!-- Phones get one card per row with the photo beside the text: two ~150px
     columns broke "Eduskuntavaaliehdokas" and the bio mid-word. From sm up the
     photo stacks over the text in the multi-column gallery. -->
<div
  class="rounded-card bg-surface-dark-green flex gap-3 border border-white/[0.14] p-3 shadow-[0_1px_0_rgba(255,255,255,.18)_inset,0_14px_34px_rgba(0,0,0,.16)] sm:flex-col sm:gap-2 sm:p-4"
>
  <!-- Photo and name both lead to the person page; the photo link is kept out
       of the tab order and accessibility tree so it isn't announced twice. -->
  <a
    href={href}
    tabindex="-1"
    aria-hidden="true"
    class="-my-3 -ml-3 w-[112px] flex-shrink-0 sm:-m-4 sm:mb-1 sm:w-auto"
  >
    <!-- 112px wide beside the text on phones; from sm up cards sit in a
         minmax(190px,1fr) grid, ~200px wide in the 1100px gallery. -->
    <Picture
      src={photo}
      alt=""
      width={480}
      widths={[240, 480]}
      sizes="(min-width: 1100px) 210px, (min-width: 640px) calc(50vw - 22px), 112px"
      formats={['webp']}
      loading="lazy"
      pictureAttributes={{ class: 'contents' }}
      class="rounded-l-card sm:rounded-tr-card bg-vihrea-tumma aspect-[3/4] h-full w-full max-w-none object-cover object-top sm:h-auto sm:rounded-bl-none"
    />
  </a>
  <div class="flex min-w-0 flex-1 flex-col gap-2">
    <h3 class="text-kerma text-[18px] leading-[1.15] font-extrabold tracking-[-0.01em]">
      <a href={href} class="hover:underline">{name}</a>
    </h3>
    {
      candidateBadge && (
        <span
          data-district={district}
          class="bg-kerma text-musta self-start rounded-[10px] px-[8px] py-[3px] text-[12px] leading-[1.3] font-semibold tracking-[0.01em]"
        >
          {candidateBadge}
        </span>
      )
    }
    <!-- A snippet of the bio, clamped (three lines on phones, four above);
         the full sentence is on the person page. -->
    <p
      class="text-kerma/[0.92] line-clamp-3 flex-1 text-[14px] leading-[1.45] hyphens-auto sm:line-clamp-4"
    >
      {summary}
    </p>
    <div class="flex flex-wrap items-center justify-between gap-x-3 gap-y-2">
      <a href={href} class="text-kerma text-[13px] font-semibold hover:underline">
        {cta}
        <span aria-hidden="true">→</span><span class="sr-only">: {name}</span>
      </a>
      {
        donationUrl && (
          <a
            href={donationUrl}
            target="_blank"
            rel="noopener"
            class="bg-kerma text-musta rounded-[20px] px-[12px] py-[4px] text-[13px] font-semibold hover:underline"
          >
            {donateLabel}
            <span class="sr-only">: {name}</span>
          </a>
        )
      }
    </div>
  </div>
</div>
