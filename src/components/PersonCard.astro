---
// Compact gallery tile for one person: photo, name and candidate badge. The
// bio and profile links live only on the person page, so that page — not the
// gallery — is the one search engines and answer engines associate with the
// person's name, and the tile stays small enough to show many people at once.
import type { ImageMetadata } from 'astro'
import { Picture } from 'astro:assets'

interface Props {
  name: string
  /** The person's own page. */
  href: string
  photo: ImageMetadata
  candidateBadge?: string
  /** District key, exposed on the badge for the about page's district filter. */
  district?: string
  /** The candidate's donation form, linked at the bottom of the tile. */
  donationUrl?: string
  /** Link text for the donation form, e.g. "Lahjoita". */
  donateLabel: string
}

const { name, href, photo, candidateBadge, district, donationUrl, donateLabel } = Astro.props
---

<div
  class="rounded-card bg-surface-dark-green flex flex-col gap-2 border border-white/[0.14] p-3 shadow-[0_1px_0_rgba(255,255,255,.18)_inset,0_14px_34px_rgba(0,0,0,.16)]"
>
  <!-- Photo and name both lead to the person page; the photo link is kept out
       of the tab order and accessibility tree so it isn't announced twice. -->
  <a href={href} tabindex="-1" aria-hidden="true" class="-m-3 mb-1 flex-shrink-0">
    <!-- Tiles sit in a minmax(150px,1fr) grid on phones (two columns) and
         minmax(190px,1fr) above, ~200px wide in the 1100px gallery. -->
    <Picture
      src={photo}
      alt=""
      width={480}
      widths={[240, 480]}
      sizes="(min-width: 1100px) 210px, calc(50vw - 22px)"
      formats={['webp']}
      loading="lazy"
      pictureAttributes={{ class: 'contents' }}
      class="rounded-t-card bg-vihrea-tumma aspect-[3/4] w-full max-w-none object-cover object-top"
    />
  </a>
  <h3 class="text-kerma text-[18px] leading-[1.15] font-extrabold tracking-[-0.01em]">
    <a href={href} class="hover:underline">{name}</a>
  </h3>
  {
    candidateBadge && (
      <span
        data-district={district}
        class="bg-kerma text-musta self-start rounded-[10px] px-[8px] py-[3px] text-[12px] leading-[1.3] font-semibold tracking-[0.01em]"
      >
        {candidateBadge}
      </span>
    )
  }
  {
    donationUrl && (
      <a
        href={donationUrl}
        target="_blank"
        rel="noopener"
        class="bg-kerma text-musta mt-auto self-start rounded-[20px] px-[12px] py-[4px] text-[13px] font-semibold hover:underline"
      >
        {donateLabel}
        <span class="sr-only">: {name}</span>
      </a>
    )
  }
</div>
