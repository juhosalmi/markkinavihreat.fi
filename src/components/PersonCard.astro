---
import SocialLinks from './SocialLinks.astro'
import { assetPath } from '../lib/content'

interface SocialLink {
  type: string
  url: string
  label?: string
}

interface Props {
  name: string
  photo: string
  candidateBadge?: string
  links: SocialLink[]
}

const { name, photo, candidateBadge, links } = Astro.props
---

<div
  class="rounded-card bg-surface-dark-green flex flex-col gap-[14px] border border-white/[0.14] p-[28px] shadow-[0_1px_0_rgba(255,255,255,.18)_inset,0_14px_34px_rgba(0,0,0,.16)]"
>
  <img
    src={assetPath(photo)}
    alt={name}
    loading="lazy"
    class="rounded-t-card bg-vihrea-tumma -m-[28px] mb-0 aspect-[3/4] w-[calc(100%_+_56px)] max-w-none flex-shrink-0 object-cover object-top"
  />
  <h3 class="text-kerma mt-[10px] text-[24px] leading-[1.1] font-extrabold tracking-[-0.01em]">
    {name}
  </h3>
  {
    candidateBadge && (
      <span class="bg-kerma text-musta self-start rounded-[20px] px-[10px] py-[5px] text-[12px] font-semibold tracking-[0.01em]">
        {candidateBadge}
      </span>
    )
  }
  <div class="text-kerma/[0.92] flex-1 text-[16px] leading-[1.55] [&_a]:underline">
    <slot />
  </div>
  <SocialLinks links={links} />
</div>
