---
// Gallery teaser for one person. The full bio and profile links live only on
// the person page, so that page — not the gallery — is the one search engines
// and answer engines associate with the person's name.
import type { ImageMetadata } from 'astro'
import { Picture } from 'astro:assets'

interface Props {
  name: string
  /** The person's own page. */
  href: string
  photo: ImageMetadata
  candidateBadge?: string
  /** The bio's opening sentence (see firstSentenceOfBio). */
  summary: string
  /** Link text for the person page, e.g. "Lue lisää". */
  cta: string
}

const { name, href, photo, candidateBadge, summary, cta } = Astro.props
---

<div
  class="rounded-card bg-surface-dark-green flex flex-col gap-[14px] border border-white/[0.14] p-[28px] shadow-[0_1px_0_rgba(255,255,255,.18)_inset,0_14px_34px_rgba(0,0,0,.16)]"
>
  <!-- Photo and name both lead to the person page; the photo link is kept out
       of the tab order and accessibility tree so it isn't announced twice. -->
  <a href={href} tabindex="-1" aria-hidden="true" class="-m-[28px] mb-0 flex-shrink-0">
    <!-- Cards sit in a minmax(300px,1fr) grid inside the 800px content column:
         ~386px wide in two columns, up to the full viewport width in one. -->
    <Picture
      src={photo}
      alt=""
      width={800}
      widths={[400, 800]}
      sizes="(min-width: 664px) 386px, calc(100vw - 32px)"
      formats={['webp']}
      loading="lazy"
      pictureAttributes={{ class: 'contents' }}
      class="rounded-t-card bg-vihrea-tumma aspect-[3/4] w-full max-w-none object-cover object-top"
    />
  </a>
  <h3 class="text-kerma mt-[10px] text-[24px] leading-[1.1] font-extrabold tracking-[-0.01em]">
    <a href={href} class="hover:underline">{name}</a>
  </h3>
  {
    candidateBadge && (
      <span class="bg-kerma text-musta self-start rounded-[20px] px-[10px] py-[5px] text-[12px] font-semibold tracking-[0.01em]">
        {candidateBadge}
      </span>
    )
  }
  <p class="text-kerma/[0.92] flex-1 text-[16px] leading-[1.55]">{summary}</p>
  <a href={href} class="text-kerma self-start text-[15px] font-semibold hover:underline">
    {cta}
    <span aria-hidden="true">→</span><span class="sr-only">: {name}</span>
  </a>
</div>
