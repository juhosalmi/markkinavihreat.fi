---
import { getEntry, render, type CollectionEntry } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { parseLocalizedId, type Locale } from '../../lib/content'
import { dateSlug, formatDate } from '../../lib/date'
import { personPath } from '../../lib/team'

interface Props {
  locale: Locale
  post: CollectionEntry<'blog'>
}

const { locale, post } = Astro.props
const { Content } = await render(post)
const path = `/blogi/${dateSlug(post.data.date)}/${parseLocalizedId(post.id).slug}/`
const authors = await Promise.all(
  post.data.authors.map(async (slug) => {
    const person = await getEntry('team', `${slug}.${locale}`)
    if (!person) throw new Error(`Blog post "${post.id}" names unknown author "${slug}"`)
    return { name: person.data.name, href: personPath(locale, slug) }
  }),
)
---

<BaseLayout
  locale={locale}
  title={`${post.data.title} — markkinavihreat.fi`}
  description={post.data.description}
  path={path}
  ogType="article"
  publishedTime={post.data.date}
>
  <article class="content-max mx-auto px-4 py-16 sm:px-6">
    <p class="text-vihrea-tumma font-semibold">
      {formatDate(post.data.date, locale)}
      {
        authors.map((author, i) => (
          <>
            {i === 0 ? ' · ' : ', '}
            <a href={author.href} rel="author" class="underline">
              {author.name}
            </a>
          </>
        ))
      }
    </p>
    <h1 class="mt-2 text-4xl sm:text-5xl">{post.data.title}</h1>
    <div class="prose-body mt-8 space-y-5 text-lg leading-relaxed">
      <Content />
    </div>
  </article>
</BaseLayout>
