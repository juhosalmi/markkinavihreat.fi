---
import { getEntry, render, type CollectionEntry } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { localePath, parseLocalizedId, type Locale } from '../../lib/content'
import { dateSlug, formatDate } from '../../lib/date'
import { ogUrlFor } from '../../lib/og'
import { personPath } from '../../lib/team'
import { articleNode, breadcrumbNode, SITE_URL } from '../../lib/structuredData'
import { blogPage } from '../../i18n/pages'

interface Props {
  locale: Locale
  post: CollectionEntry<'blog'>
}

const { locale, post } = Astro.props
const { Content } = await render(post)
const path = `/blogi/${dateSlug(post.data.date)}/${parseLocalizedId(post.id).slug}/`
const authors = await Promise.all(
  post.data.authors.map(async (slug) => {
    const person = await getEntry('team', `${slug}.${locale}`)
    if (!person) throw new Error(`Blog post "${post.id}" names unknown author "${slug}"`)
    return { slug, name: person.data.name, href: personPath(locale, slug) }
  }),
)

const canonical = `${SITE_URL}${localePath(locale, path)}`
const jsonLd = [
  articleNode({
    url: canonical,
    headline: post.data.title,
    description: post.data.description,
    locale,
    image: ogUrlFor(locale, path),
    published: post.data.date,
    authors: authors.map((a) => ({ slug: a.slug, name: a.name, url: `${SITE_URL}${a.href}` })),
  }),
  breadcrumbNode([
    { name: 'Markkinavihreät', url: `${SITE_URL}${localePath(locale, '/')}` },
    { name: blogPage[locale].title, url: `${SITE_URL}${localePath(locale, '/blogi/')}` },
    { name: post.data.title, url: canonical },
  ]),
]
---

<BaseLayout
  locale={locale}
  title={`${post.data.title} — markkinavihreat.fi`}
  description={post.data.description}
  path={path}
  ogType="article"
  publishedTime={post.data.date}
  jsonLd={jsonLd}
>
  <article class="content-max mx-auto px-4 py-16 sm:px-6">
    <p class="text-vihrea-tumma font-semibold">
      {formatDate(post.data.date, locale)}
      {
        authors.map((author, i) => (
          <>
            {i === 0 ? ' · ' : ', '}
            <a href={author.href} rel="author" class="underline">
              {author.name}
            </a>
          </>
        ))
      }
    </p>
    <h1 class="mt-2 text-4xl sm:text-5xl">{post.data.title}</h1>
    <div class="prose-body mt-8 space-y-5 text-lg leading-relaxed">
      <Content />
    </div>
  </article>
</BaseLayout>
