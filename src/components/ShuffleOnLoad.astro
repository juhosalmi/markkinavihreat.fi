---
interface Props {
  /**
   * CSS selector matching every element whose content should be shuffled
   * among each other. Unlike reordering a single container's children, this
   * swaps innerHTML between elements, so it also works when the matches are
   * scattered as siblings of unrelated content (e.g. quote bands interleaved
   * between page sections) and their positions must stay fixed.
   */
  selector: string
}

const { selector } = Astro.props
---

<script is:inline define:vars={{ selector }}>
  const nodes = document.querySelectorAll(selector)
  if (nodes.length > 1) {
    const contents = Array.from(nodes, (node) => node.innerHTML)
    for (let i = contents.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1))
      ;[contents[i], contents[j]] = [contents[j], contents[i]]
    }
    nodes.forEach((node, i) => {
      node.innerHTML = contents[i]
    })
  }
</script>
