---
interface Props {
  name: string
  photo: string
  quote: string
}

const { name, photo, quote } = Astro.props
---

<div class="bg-musta text-kerma px-8 py-20 text-center">
  <div
    class="content-max mx-auto flex flex-col items-center gap-8 md:flex-row md:items-center md:text-left"
  >
    <div
      class="rounded-card h-[clamp(140px,85vw,280px)] w-[clamp(93px,56.7vw,187px)] flex-shrink-0 overflow-hidden"
    >
      <img
        src={photo}
        alt={name}
        loading="lazy"
        class="block h-full w-full object-cover object-top"
      />
    </div>
    <div>
      <blockquote
        class="mx-auto mb-4 max-w-[44ch] text-[clamp(20px,3vw,26px)] leading-[1.35] font-semibold italic md:mx-0"
      >
        "{quote}"
      </blockquote>
      <span class="text-vihrea block text-[16px] font-extrabold tracking-[0.1em] uppercase"
        >{name}</span
      >
    </div>
  </div>
</div>
