---
interface Props {
  name: string
  photo: string
  quote: string
}

const { name, photo, quote } = Astro.props
---

<div
  class="bg-musta text-kerma flex flex-col items-center gap-6 px-6 py-12 text-center sm:flex-row sm:text-left"
>
  <img
    src={photo}
    alt={name}
    class="h-24 w-24 flex-shrink-0 rounded-full object-cover object-top"
    loading="lazy"
  />
  <div>
    <blockquote class="text-lg leading-relaxed italic">"{quote}"</blockquote>
    <p class="text-kerma/70 mt-3 font-semibold">— {name}</p>
  </div>
</div>
