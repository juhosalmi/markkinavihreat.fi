---
import type { ImageMetadata } from 'astro'
import { Picture } from 'astro:assets'

interface Props {
  name: string
  photo: ImageMetadata
  quote: string
  /** The person's page; makes the name a link. */
  href?: string
  class?: string
}

const { name, photo, quote, href, class: className } = Astro.props
---

<div class:list={['bg-musta text-kerma px-8 py-20 text-center', className]}>
  <div
    class="content-max mx-auto flex flex-col items-center gap-8 md:flex-row md:items-center md:text-left"
  >
    <div
      class="rounded-card h-[clamp(140px,85vw,280px)] w-[clamp(93px,56.7vw,187px)] flex-shrink-0 overflow-hidden"
    >
      <!-- The box is at most 187×280 CSS px; object-cover on a ~3:4 photo
           needs ~210px of width to fill that height. -->
      <Picture
        src={photo}
        alt={name}
        width={480}
        widths={[240, 480]}
        sizes="210px"
        formats={['webp']}
        loading="lazy"
        pictureAttributes={{ class: 'contents' }}
        class="block h-full w-full object-cover object-top"
      />
    </div>
    <div>
      <blockquote
        class="mx-auto mb-4 max-w-[44ch] text-[clamp(20px,3vw,26px)] leading-[1.35] font-semibold italic md:mx-0"
      >
        "{quote}"
      </blockquote>
      {
        href ? (
          <a
            href={href}
            class="text-vihrea block text-[16px] font-extrabold tracking-[0.1em] uppercase hover:underline"
          >
            {name}
          </a>
        ) : (
          <span class="text-vihrea block text-[16px] font-extrabold tracking-[0.1em] uppercase">
            {name}
          </span>
        )
      }
    </div>
  </div>
</div>
