---
import { LOCALES, localePath, type Locale } from '../lib/content'
import { t } from '../i18n/ui'

interface Props {
  locale: Locale
  path: string
}

const { locale, path } = Astro.props

const links: { key: Parameters<typeof t>[1]; href: string }[] = [
  { key: 'nav.about', href: '/ketka/' },
  { key: 'nav.manifesto', href: '/manifesti/' },
  { key: 'nav.programs', href: '/ehdotukset/' },
  { key: 'nav.blog', href: '/blogi/' },
  { key: 'nav.contact', href: '/yhteystiedot/' },
]

const WHATSAPP_URL = 'https://chat.whatsapp.com/DFBhxqTOmLRHqGgUzupy7L'
const localeLabels: Record<Locale, string> = { fi: 'FI', sv: 'SV', en: 'EN' }
---

<nav class="bg-kerma/95 sticky top-0 z-50 border-b border-transparent backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-4 sm:px-6">
    <a href={localePath(locale, '/')} class="text-lg font-extrabold">
      markkina<span class="text-vihreat-brand">vihreät</span>.fi
    </a>

    <button
      class="text-2xl sm:hidden"
      aria-expanded="false"
      aria-controls="primary-nav"
      id="nav-toggle"
    >
      <i class="fa-solid fa-bars" aria-hidden="true"></i>
      <span class="sr-only">Menu</span>
    </button>

    <div
      id="primary-nav"
      class="hidden w-full flex-col gap-4 sm:flex sm:w-auto sm:flex-row sm:items-center"
    >
      <ul class="flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-6">
        {
          links.map((link) => (
            <li>
              <a href={localePath(locale, link.href)} class="hover:text-vihrea-tumma font-medium">
                {t(locale, link.key)}
              </a>
            </li>
          ))
        }
      </ul>

      <div class="flex items-center gap-3">
        <a href={WHATSAPP_URL} class="btn-outline-sm" target="_blank" rel="noopener">
          {t(locale, 'nav.whatsapp')}
        </a>
        <div class="flex items-center gap-2" aria-label={t(locale, 'nav.lang')}>
          {
            LOCALES.map((l) => (
              <a
                href={l === locale ? undefined : localePath(l, path)}
                aria-current={l === locale ? 'page' : undefined}
                class:list={[
                  'text-sm font-semibold',
                  l === locale ? 'text-musta' : 'text-harmaa hover:text-musta',
                ]}
              >
                {localeLabels[l]}
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</nav>

<script>
  const toggle = document.getElementById('nav-toggle')
  const menu = document.getElementById('primary-nav')
  toggle?.addEventListener('click', () => {
    const isOpen = menu?.classList.toggle('flex')
    menu?.classList.toggle('hidden')
    toggle.setAttribute('aria-expanded', String(Boolean(isOpen)))
  })
</script>
